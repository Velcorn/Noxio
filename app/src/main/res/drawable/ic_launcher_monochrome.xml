<?xml version="1.0" encoding="utf-8"?>
<!-- Single-color version for themed icons: the launcher tints it, only the alpha matters. The crescent and the play button are thin outlines with round ends, like the icons of
     Arcticons, so the icon does not stand out in a launcher that uses them. Some launchers
     (Kvaesitso, for one) draw the artwork of an app enlarged and cut off what reaches the edge,
     so the artwork is kept small enough to survive that: Kvaesitso shows about the middle half of
     the 108 grid, and the strokes reach about 1 beyond the outlines. The lines are as thin as those of Arcticons. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.86"
        android:scaleY="0.86">
        <path
            android:fillColor="#00000000"
            android:pathData="M69.818 28.509A30 30 0 1 0 69.818 79.491A27.5 27.5 0 1 1 69.818 28.509Z"
            android:strokeColor="#000000"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="1.9" />
        <path
            android:fillColor="#00000000"
            android:pathData="M47 41L47 67L68 54Z"
            android:strokeColor="#000000"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:strokeWidth="1.9" />
        <path
            android:fillColor="#000000"
            android:pathData="M75 32Q77.1 35.9 81 38Q77.1 40.1 75 44Q72.9 40.1 69 38Q72.9 35.9 75 32Z" />
    </group>
</vector>
