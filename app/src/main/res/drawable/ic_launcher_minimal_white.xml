<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal icon artwork, white lines.
     Drawn like the icons of Arcticons: a 48 unit grid, 1 unit lines with round ends, plain open
     outlines and no gaps that are small enough to disappear. The group maps the 48 grid onto the
     middle 60 of the 108 units of the adaptive icon, which is all that Kvaesitso shows. -->
