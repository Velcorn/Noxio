<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/set_audio">

    <SwitchPreferenceCompat
        app:defaultValue="true"
        app:key="@string/set_key_keep_shuffle"
        app:summary="@string/set_keep_shuffle_desc"
        app:title="@string/set_keep_shuffle" />

    <SwitchPreferenceCompat
        app:defaultValue="true"
        app:key="@string/set_key_rewind_prev"
        app:summary="@string/set_rewind_prev_desc"
        app:title="@string/set_rewind_prev" />

    <Preference
        app:key="@string/set_key_equalizer"
        app:summary="@string/set_equalizer_desc"
        app:title="@string/lbl_equalizer" />

    <org.oxycblt.auxio.settings.ui.InfoCategory
        app:infoMessage="@string/lbl_info_strategy"
        app:infoTitle="@string/lbl_info_strategy_title"
        app:title="@string/set_replay_gain">

        <org.oxycblt.auxio.settings.ui.IntListPreference
            app:defaultValue="@integer/replay_gain_dynamic"
            app:entries="@array/entries_replay_gain"
            app:entryValues="@array/values_replay_gain"
            app:key="@string/set_key_replay_gain"
            app:title="@string/set_replay_gain_mode" />

    </org.oxycblt.auxio.settings.ui.InfoCategory>

    <org.oxycblt.auxio.settings.ui.InfoCategory
        app:infoMessage="@string/lbl_replay_gain_info"
        app:infoTitle="@string/lbl_replay_gain_info_title"
        app:title="@string/set_replay_gain_calculated">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="@string/set_key_replay_gain_prefer_tags"
            app:summary="@string/set_replay_gain_prefer_tags_desc"
            app:title="@string/set_replay_gain_prefer_tags" />

        <Preference
            app:key="@string/set_key_replay_gain_scan"
            app:summary="@string/set_replay_gain_scan_desc"
            app:title="@string/lbl_replay_gain_scan" />

        <Preference
            app:key="@string/set_key_replay_gain_write"
            app:summary="@string/set_replay_gain_write_desc"
            app:title="@string/set_replay_gain_write" />

        <Preference
            app:key="@string/set_key_replay_gain_clear"
            app:title="@string/set_replay_gain_clear" />

    </org.oxycblt.auxio.settings.ui.InfoCategory>

</PreferenceScreen>
