<?xml version="1.0" encoding="utf-8"?>
<!-- Maps Noxio's own launcher activity to the minimal icon. Launchers that read icon packs, like Kvaesitso,
     can then show it instead of the full-color icon. The debug build has a different package name. -->
<resources>
    <item
        component="ComponentInfo{de.devfin.noxio/org.oxycblt.auxio.MainActivity}"
        drawable="noxio_minimal" />
    <item
        component="ComponentInfo{de.devfin.noxio.debug/org.oxycblt.auxio.MainActivity}"
        drawable="noxio_minimal" />
</resources>
