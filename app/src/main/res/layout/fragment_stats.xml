<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:transitionGroup="true"
    tools:context=".stats.StatsFragment">

    <org.oxycblt.auxio.ui.CoordinatorAppBarLayout
        android:id="@+id/stats_appbar"
        style="@style/Widget.Auxio.AppBarLayout"
        app:liftOnScroll="true">

        <org.oxycblt.auxio.ui.AuxioToolbar
            android:id="@+id/stats_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/toolbar_stats"
            app:navigationIcon="@drawable/ic_back_24"
            app:title="@string/lbl_stats" />

    </org.oxycblt.auxio.ui.CoordinatorAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/stats_contents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_medium"
            android:paddingBottom="96dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/stats_period_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                app:selectionRequired="true"
                app:singleSelection="true">

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/stats_week"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lbl_stats_week" />

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/stats_month"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lbl_stats_month" />

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/stats_year"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lbl_stats_year" />

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/stats_all"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lbl_stats_all" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/stats_prev"
                    style="@style/Widget.Auxio.Button.Playback.More"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/lbl_stats_previous"
                    app:icon="@drawable/ic_back_24"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small" />

                <TextView
                    android:id="@+id/stats_range"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="Nov 2 – Nov 8, 2026" />

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/stats_next"
                    style="@style/Widget.Auxio.Button.Playback.More"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/lbl_stats_next"
                    android:rotation="180"
                    app:icon="@drawable/ic_back_24"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small" />

            </LinearLayout>

            <TextView
                android:id="@+id/stats_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_large"
                android:gravity="center"
                android:text="@string/lbl_stats_empty"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/stats_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:background="@drawable/bg_stats_hero"
                android:baselineAligned="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_mid_large"
                android:paddingVertical="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/stats_hero_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceHeadlineSmallEmphasized"
                    android:textColor="@color/stats_on_card"
                    tools:text="6 h 41 min" />

                <TextView
                    android:id="@+id/stats_hero_plays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/stats_on_card_dim"
                    tools:text="112 plays" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/stats_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_mid_medium"
                android:background="@drawable/bg_stats_artists"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_medium"
                android:paddingTop="@dimen/spacing_mid_medium"
                android:paddingBottom="@dimen/spacing_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_tiny">

                    <TextView
                        android:id="@+id/stats_card_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAllCaps="true"
                        android:textAppearance="?attr/textAppearanceLabelLargeEmphasized"
                        android:textColor="@color/stats_on_card"
                        tools:text="Top artists" />

                    <org.oxycblt.auxio.ui.RippleFixMaterialButton
                        android:id="@+id/stats_share"
                        style="@style/Widget.Auxio.Button.Playback.More"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/lbl_stats_share"
                        app:icon="@drawable/ic_share_24"
                        app:iconTint="@color/stats_on_card"
                        app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stats_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/stats_more"
                style="?attr/materialButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/lbl_stats_show_ten" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/stats_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/spacing_medium"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/stats_category_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_tiny"
            app:selectionRequired="true"
            app:singleSelection="true">

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/stats_artists"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_stats_artists" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/stats_albums"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_stats_albums" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/stats_songs"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_stats_songs" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
