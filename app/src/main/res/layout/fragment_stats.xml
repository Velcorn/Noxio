<?xml version="1.0" encoding="utf-8"?>
<!-- The totals and the card are centered between the categories at the top and the controls at
     the bottom (range, period), with back in the bar underneath. There is no top bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:transitionGroup="true"
    tools:ignore="Overdraw"
    tools:context=".stats.StatsFragment">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/stats_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginBottom="@dimen/spacing_small"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/stats_category_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/spacing_tiny"
            app:selectionRequired="true"
            app:singleSelection="true">

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/stats_artists"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_stats_artists" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/stats_albums"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_stats_albums" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/stats_songs"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_stats_songs" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/stats_contents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_medium">

            <TextView
                android:id="@+id/stats_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/spacing_large"
                android:gravity="center"
                android:text="@string/lbl_stats_empty"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/stats_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:background="@drawable/bg_stats_hero"
                android:baselineAligned="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_mid_large"
                android:paddingVertical="@dimen/spacing_medium">

                <TextView
                    android:id="@+id/stats_hero_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceHeadlineSmallEmphasized"
                    android:textColor="@color/stats_on_card"
                    tools:text="6 h 41 min" />

                <TextView
                    android:id="@+id/stats_hero_plays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/stats_on_card_dim"
                    tools:text="112 plays" />

            </LinearLayout>
            <LinearLayout
                android:id="@+id/stats_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_mid_medium"
                android:background="@drawable/bg_stats_artists"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_medium"
                android:paddingTop="@dimen/spacing_mid_medium"
                android:paddingBottom="@dimen/spacing_small">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_tiny"
                    android:paddingEnd="@dimen/spacing_tiny">

                    <TextView
                        android:id="@+id/stats_card_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAllCaps="true"
                        android:textAppearance="?attr/textAppearanceLabelLargeEmphasized"
                        android:textColor="@color/stats_on_card"
                        tools:text="Top artists" />

                    <org.oxycblt.auxio.ui.RippleFixMaterialButton
                        android:id="@+id/stats_share"
                        style="@style/Widget.Auxio.Button.Playback.More"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/lbl_stats_share"
                        app:icon="@drawable/ic_share_24"
                        app:iconTint="@color/stats_on_card"
                        app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/stats_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>
            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/stats_more"
                style="?attr/materialButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/lbl_stats_show_ten" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/stats_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/stats_prev"
                    style="@style/Widget.Auxio.Button.Playback.More"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/lbl_stats_previous"
                    app:icon="@drawable/ic_back_24"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small" />

                <TextView
                    android:id="@+id/stats_range"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="Nov 2 – Nov 8, 2026" />

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/stats_next"
                    style="@style/Widget.Auxio.Button.Playback.More"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/lbl_stats_next"
                    android:rotation="180"
                    app:icon="@drawable/ic_back_24"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Small" />

            </LinearLayout>
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/stats_period_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                                app:selectionRequired="true"
                app:singleSelection="true">

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/stats_week"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lbl_stats_week" />

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/stats_month"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lbl_stats_month" />

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/stats_year"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lbl_stats_year" />

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/stats_all"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lbl_stats_all" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/stats_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_detail_bottom_bar"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_tiny"
        android:paddingEnd="@dimen/spacing_tiny">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/spacing_small"
            android:text="@string/lbl_stats"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?android:attr/textColorSecondary" />

        <ImageButton
            android:id="@+id/stats_menu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/lbl_more"
            android:src="@drawable/ic_more_vert_24"
            app:tint="?attr/colorOnSurface" />

    </LinearLayout>

</LinearLayout>
