<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/sleep_handle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/sleep_title"
            style="@style/Widget.Auxio.TextView.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_medium"
            android:text="@string/lbl_sleep_timer" />

        <!-- Shown while no timer is running -->
        <LinearLayout
            android:id="@+id/sleep_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_medium"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/sleep_30"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checkable="true" />

                <!-- The label button and the input share one tile -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_small"
                    android:layout_weight="1">

                    <org.oxycblt.auxio.ui.RippleFixMaterialButton
                        android:id="@+id/sleep_custom"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="@string/lbl_sleep_custom" />

                    <LinearLayout
                        android:id="@+id/sleep_custom_edit_row"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <EditText
                            android:id="@+id/sleep_custom_input"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autofillHints="off"
                            android:gravity="center"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="3"
                            android:minWidth="40dp"
                            android:contentDescription="@string/lbl_sleep_minutes"
                            android:textAppearance="?attr/textAppearanceLabelLarge" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/sleep_custom_input"
                            android:text="@string/lbl_sleep_unit"
                            android:textAppearance="?attr/textAppearanceLabelLarge" />

                    </LinearLayout>

                </FrameLayout>

                <org.oxycblt.auxio.ui.RippleFixMaterialButton
                    android:id="@+id/sleep_60"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checkable="true" />

            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sleep_finish_song"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:minHeight="@dimen/size_touchable_small"
                android:text="@string/lbl_sleep_finish_song" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sleep_fade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:minHeight="@dimen/size_touchable_small"
                android:text="@string/lbl_sleep_fade" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sleep_shake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:minHeight="@dimen/size_touchable_small"
                android:text="@string/lbl_sleep_shake" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/sleep_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:text="@string/lbl_sleep_start" />

        </LinearLayout>

        <!-- Shown while a timer is running -->
        <LinearLayout
            android:id="@+id/sleep_running"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_medium"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/sleep_remaining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="@dimen/spacing_medium"
                android:textAppearance="?attr/textAppearanceDisplayMedium"
                android:fontFeatureSettings="tnum"
                tools:text="29:41" />

            <TextView
                android:id="@+id/sleep_remaining_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="@dimen/spacing_medium"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="@string/lbl_sleep_stops_when_over" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/sleep_restart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lbl_sleep_restart" />

            <org.oxycblt.auxio.ui.RippleFixMaterialButton
                android:id="@+id/sleep_stop"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:layout_marginBottom="@dimen/spacing_medium"
                android:text="@string/lbl_sleep_stop" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
