<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:transitionGroup="true"
    tools:context=".settings.ChangelogFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/changelog_contents"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/size_detail_bottom_bar"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/changelog_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_medium"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <!-- Title at the bottom, like About and the settings -->
    <LinearLayout
        android:id="@+id/changelog_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_detail_bottom_bar"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_tiny"
        android:paddingEnd="@dimen/spacing_tiny">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/spacing_small"
            android:text="@string/lbl_changelog"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
