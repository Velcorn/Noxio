<?xml version="1.0" encoding="utf-8"?>
<!-- The controls of a detail screen along the bottom, in the thumb zone: back, the name, play,
     shuffle and more. While the order of a playlist is edited they make way for Cancel and Save. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detail_bottom_bar"
    tools:ignore="Overdraw"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_gravity="bottom"
    android:background="?attr/colorSurface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_tiny"
    android:paddingEnd="@dimen/spacing_tiny">

    <ImageButton
        android:id="@+id/bar_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/desc_back"
        android:src="@drawable/ic_back_24"
        app:tint="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/bar_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/spacing_small"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?android:attr/textColorSecondary" />

    <!-- Only on screens whose list can be sorted (album, genre) -->
    <ImageButton
        android:id="@+id/bar_sort"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/lbl_sort"
        android:src="@drawable/ic_sort_20"
        android:visibility="gone"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/bar_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/lbl_play"
        android:src="@drawable/ic_play_24"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/bar_shuffle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/lbl_shuffle"
        android:src="@drawable/ic_shuffle_off_24"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/bar_more"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/lbl_more"
        android:src="@drawable/ic_more_vert_24"
        app:tint="?attr/colorOnSurface" />

    <!-- Only while editing the order of a playlist -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/bar_cancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_cancel"
        android:visibility="gone" />

    <View
        android:id="@+id/bar_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bar_save"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_save"
        android:visibility="gone" />

</LinearLayout>
