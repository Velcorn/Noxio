<?xml version="1.0" encoding="utf-8"?>
<!-- Cancel and Save along the bottom, in the thumb zone, while the order of a playlist is edited.
     The rest of the time the main navigation (see MainFragment) is there instead. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detail_bottom_bar"
    android:visibility="gone"
    tools:ignore="Overdraw"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_gravity="bottom"
    android:background="?attr/colorSurface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_tiny"
    android:paddingEnd="@dimen/spacing_tiny">

    <!-- Only while editing the order of a playlist -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/bar_cancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_cancel" />

    <View
        android:id="@+id/bar_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/bar_save"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_save" />

</LinearLayout>
